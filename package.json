{
  "name": "c-forge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "npm run content:audit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "content:audit": "node --import tsx scripts/audit-content.ts",
    "content:verify": "node --import tsx scripts/verify-content.ts",
    "runner": "node --import tsx runner/worker.ts",
    "backup": "node --import tsx scripts/admin.ts backup",
    "format": "prettier --write src server shared runner tests scripts content/*.json playwright*.config.ts",
    "format:check": "prettier --check src server shared runner tests scripts content/*.json playwright*.config.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "lint": "eslint src server shared runner tests scripts vite.config.ts playwright.config.ts playwright.https.config.ts playwright.subpath.config.ts playwright.multi.config.ts playwright.courses.config.ts",
    "test:https": "playwright test --config playwright.https.config.ts",
    "test:docker": "node --import tsx scripts/docker-smoke.ts",
    "test:subpath": "playwright test --config playwright.subpath.config.ts",
    "build:site": "npm run build && node scripts/embed-frontend.mjs && bash scripts/build.sh && node scripts/validate-artifact.mjs",
    "test:multi-user": "playwright test --config playwright.multi.config.ts",
    "test:courses": "playwright test --config playwright.courses.config.ts",
    "preview": "npm run build && npm start"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "5.104.2",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "idb": "8.0.4",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
