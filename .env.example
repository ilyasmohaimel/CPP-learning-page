# Sanitized defaults: no real credentials. Node24+ required.
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
# Use true behind HTTPS; local HTTP development uses false.
COOKIE_SECURE=false
# Root deployment defaults. For a reverse-proxied /forge/ installation, build with
# CFORGE_BASE_PATH=/forge/ and set COOKIE_NAME=cforge_session, COOKIE_PATH=/forge/.
CFORGE_BASE_PATH=/
COOKIE_NAME=session
COOKIE_PATH=/
# Enable only when a loopback Nginx proxy overwrites X-Forwarded-* headers.
TRUST_PROXY_LOOPBACK=false
# Optional bootstrap override. Otherwise a private persistent file is generated.
# BOOTSTRAP_SECRET=generate-a-long-random-secret-with-your-administrator-tools
# Separate API/worker credential, >=32 chars. Unconfigured means no C execution.
# RUNNER_SECRET=generate-a-separate-long-random-secret
# Worker settings ONLY (do not give the worker DATA_DIR or app DB permissions):
# RUNNER_API_URL=http://127.0.0.1:3000
# RUNNER_IMAGE=sha256:record-the-built-immutable-toolchain-image-id

# Public multi-account signup is opt-in for portable self-hosting. Existing saves
# migrate without changing account IDs. Never make bootstrap setup public.
PUBLIC_REGISTRATION=false
# Server-to-server Site proxy credential only; generate independently and keep
# it in server/Sites secrets. Used to authenticate visitor-IP rate-limit headers.
# SITE_PROXY_SECRET=administrator-generated-random-secret-at-least-32-characters
