# Additive example for an existing IP-address HTTPS gateway.
# Only use port 8448 after confirming it is unused and ingress permits it.
# Set YOUR_SERVER_IP and certificate paths to values inspected on the live host.
# A valid IP-address certificate must cover the actual current public IP.
# Keep the existing certificate renewal/deploy hook; do not replace other sites.
server {
    listen 8448 ssl;
    server_name YOUR_SERVER_IP;
    ssl_certificate /etc/letsencrypt/live/YOUR_CERTIFICATE_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_CERTIFICATE_NAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 4m;
    location = /internal { return 404; }
    location ^~ /internal/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:3030;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
