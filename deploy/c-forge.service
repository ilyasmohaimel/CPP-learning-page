[Unit]
Description=C Forge learning application
After=network.target
[Service]
Type=simple
User=cforge
Group=cforge
WorkingDirectory=/opt/c-forge
EnvironmentFile=/etc/c-forge/app.env
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/c-forge
[Install]
WantedBy=multi-user.target
